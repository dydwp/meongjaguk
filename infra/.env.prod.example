# 멍자국 배포(운영) 서버 환경변수 예시 — infra/docker-compose.prod.yml 에서 사용
# 서버에서 복사해 값을 채운 뒤 사용:  cp infra/.env.prod.example infra/.env.prod   (.env.prod 는 커밋 금지)
# SPRING_PROFILES_ACTIVE(prod) 와 DB 접속 정보는 compose 가 자동으로 설정하므로 넣지 않음

# 서버 접속 포트 (비우면 80)
APP_PORT=

# MySQL root 비밀번호 (로컬과 다른 강한 비밀번호 사용, 앱도 이 값으로 접속)
MYSQL_ROOT_PASSWORD=

# 구글 OAuth 클라이언트 ID / 시크릿 (리디렉션 URI 에 운영 주소 등록 필요)
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENTID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENTSECRET=

# 카카오 OAuth 클라이언트 ID(REST API 키) / 시크릿
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KAKAO_CLIENTID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KAKAO_CLIENTSECRET=

# 네이버 OAuth 클라이언트 ID / 시크릿
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_NAVER_CLIENTID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_NAVER_CLIENTSECRET=

# 카카오맵 JavaScript 키 (카카오 개발자 콘솔 플랫폼에 운영 주소 등록 필요)
KAKAO_MAP_JSKEY=
