# 멍자국 Spring 앱 환경변수 예시 (값은 비워둠 — 복사해서 .env 로 만든 뒤 채워서 사용, .env 는 커밋 금지)
# application-secret.properties 가 없는 환경(CI/Docker/AWS)에서는 아래 환경변수로 값을 주입합니다.

# 실행 프로필 (배포 서버에서만 주석 해제 → application-prod.properties 적용, 로컬/compose 는 주석 유지)
# SPRING_PROFILES_ACTIVE=prod

# Docker Compose 의 MySQL root 비밀번호 (compose 실행 시 앱도 이 값으로 접속, 아래 DB 3개 값은 compose 가 덮어씀)
MYSQL_ROOT_PASSWORD=

# MySQL 접속 URL (예: jdbc:mysql://host:3306/meongjaguk?serverTimezone=Asia/Seoul&characterEncoding=UTF-8)
SPRING_DATASOURCE_URL=
# MySQL 접속 계정
SPRING_DATASOURCE_USERNAME=
# MySQL 접속 비밀번호
SPRING_DATASOURCE_PASSWORD=

# 구글 OAuth 클라이언트 ID
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENTID=
# 구글 OAuth 클라이언트 시크릿
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENTSECRET=
# 구글 OAuth 요청 scope (선택, 바꿀 때만 주석 해제 — 빈 값으로 두면 기본값 profile,email 이 지워짐)
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_SCOPE=profile,email

# 카카오 OAuth 클라이언트 ID (REST API 키)
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KAKAO_CLIENTID=
# 카카오 OAuth 클라이언트 시크릿
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KAKAO_CLIENTSECRET=

# 네이버 OAuth 클라이언트 ID
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_NAVER_CLIENTID=
# 네이버 OAuth 클라이언트 시크릿
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_NAVER_CLIENTSECRET=

# 카카오맵 JavaScript 키 (kakao.map.js-key)
KAKAO_MAP_JSKEY=
